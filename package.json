{
  "name": "thread-and-stock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.13.0" },
  "workspaces": ["admin/frontend", "admin/backend"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run dev --workspace @thread-and-stock/frontend",
    "dev:server": "npm run dev --workspace @thread-and-stock/backend",
    "build": "npm run build --workspace @thread-and-stock/frontend",
    "start": "npm run start --workspace @thread-and-stock/backend",
    "test": "npm run test --workspace @thread-and-stock/backend",
    "test:ui": "npm run test:ui --workspace @thread-and-stock/frontend",
    "check": "npm run check --workspace @thread-and-stock/frontend"
  }
}
